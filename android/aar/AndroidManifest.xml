<?xml version="1.0" encoding="utf-8"?>
<!-- Manifest entries and resources MiddleMan needs beyond what giode
     generates: the home screen widget (code: com.middlelan.app.UsageWidget),
     the permission prompt (com.middlelan.app.PermissionActivity) and the
     on-device VPN (com.middlelan.app.MiddleVpnService). Packed
     into android/libs/middlelan.aar by build-aar.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.middlelan.widget">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- The VPN runs as a foreground service of type specialUse (Android 14+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 11+ hides other apps from an app unless it says which it
         needs to see. Seeing launcher apps lets MiddleMan name the apps
         behind connections and usage instead of showing "uid 10143". -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application>
        <!-- BIND_VPN_SERVICE guards the service so only the system binds it. -->
        <service
            android:name="com.middlelan.app.MiddleVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device VPN that shows and filters which apps connect where; no traffic leaves the device through a remote server." />
        </service>
        <activity android:name="com.middlelan.app.PermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name="com.middlelan.app.VpnConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <receiver android:name="com.middlelan.app.UsageWidget" android:exported="false" android:label="MiddleMan">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/middlelan_widget_info" />
        </receiver>
    </application>
</manifest>
