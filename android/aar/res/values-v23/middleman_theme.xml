<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides the white window background of giode's activity theme,
     which shows before the app draws (and as the splash on Android 6-11).
     giode defines Theme.GioApp in values/ and values-v21/; Android picks
     the closest version qualifier, so this values-v23 copy wins on every
     device MiddleMan supports (min SDK 23) without editing the CLI. -->
<resources>
    <style name="Theme.GioApp" parent="android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@color/middleman_splash</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:navigationBarColor">@color/middleman_splash</item>
        <item name="android:statusBarColor">@color/middleman_splash</item>
    </style>
</resources>
