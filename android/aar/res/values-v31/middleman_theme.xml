<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash screen: the icon's dark indigo instead of white.
     See values-v23 for why this overrides giode's theme. -->
<resources>
    <style name="Theme.GioApp" parent="android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@color/middleman_splash</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:navigationBarColor">@color/middleman_splash</item>
        <item name="android:statusBarColor">@color/middleman_splash</item>
        <item name="android:windowSplashScreenBackground">@color/middleman_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/middleman_splash</item>
    </style>
</resources>
